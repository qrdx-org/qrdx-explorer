# QRDX Node API Configuration (REST, /rpc JSON-RPC, /ws + /stream realtime, /metrics)
# Default: http://127.0.0.1:3007 — users can switch nodes at runtime from the network switcher.
# Enable QRDX_ENABLE_STREAMING=1 on the node for push updates and QRDX_RPC_ENABLED=true for EVM data.
NEXT_PUBLIC_QRDX_NODE_URL=http://127.0.0.1:3007

# Trade API Configuration (for pricing)
# Default: https://trade.qrdx.org/api/price
NEXT_PUBLIC_TRADE_API_URL=https://trade.qrdx.org/api/price
